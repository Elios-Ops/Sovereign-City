# Ledger AI Voice Integration - API Keys
# Copy this file to .env and add your API keys for enhanced voice services

# ElevenLabs API (Premium voice synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Cloud Text-to-Speech API
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# PlayHT API (Alternative voice service)
PLAYHT_API_KEY=your_playht_api_key_here
PLAYHT_USER_ID=your_playht_user_id_here

# Voice Configuration
LEDGER_VOICE_ENABLED=true
LEDGER_VOICE_SERVICE=web_speech_api

# Note: The application works without these API keys using the Web Speech API
# Add these keys only if you want premium voice synthesis services